# apps/api — local-developer environment variables.
#
# Production paths resolve secrets via GCP Secret Manager (architecture §5.9) —
# DO NOT set the *_SECRET / pepper VALUES in any non-local execution context.
# The vars below are required at boot; a missing one is a loud startup failure
# (apps/api/src/config.ts).

# === Database connection (Story 1.2) ===
# Local-dev uses the Cloud SQL Auth Proxy loopback socket OR a Docker Postgres.
# DATABASE_URL=postgresql://twt_dev_app:CHANGE_ME@127.0.0.1:5432/twt_dev?sslmode=disable

# === Admin session (Story 1.9, §2.4) ===
# @fastify/session signing secret — MUST be ≥32 chars of random.
SESSION_SECRET=dev-only-change-me-32chars-minimum-please
# Set COOKIE_SECURE=1 to force Secure cookies over http locally (default: prod only).
# COOKIE_SECURE=0

# === WebAuthn passkey (Story 1.9, §2.3) ===
# RP ID is the registrable domain (no scheme/port). Local dev: localhost.
WEBAUTHN_RP_ID=localhost
# Expected origin is the admin app origin (scheme + host + port).
WEBAUTHN_EXPECTED_ORIGIN=http://localhost:3001
# WEBAUTHN_RP_NAME=TWT Admin

# === Argon2id password pepper (Story 1.9, §2.3, AC-1) ===
# Secret Manager secret NAME holding the pepper (the VALUE never goes in env in prod).
ARGON2_PEPPER_SECRET_NAME=twt-dev-argon2-pepper
# Local-dev fallback: the pepper VALUE, read only when Secret Manager is unavailable.
ARGON2_PEPPER=dev-only-argon2-pepper-change-me
# OWASP-2026 baseline (overridable for ops tuning). Recorded in ADR-0009.
# ARGON2_MEMORY_COST=65536
# ARGON2_TIME_COST=3
# ARGON2_PARALLELISM=1

# === Admin-identity KMS (Story 1.9 / Story 1.5 substrate) ===
# 'fake' (default, local/CI) derives keys from the pepper; 'live' uses Cloud KMS.
# KMS_TEST_MODE=fake
# Required only when KMS_TEST_MODE=live:
# ADMIN_KEK_RESOURCE_NAME=projects/.../cryptoKeys/admin-kek
# ADMIN_HMAC_RESOURCE_NAME=projects/.../cryptoKeys/admin-hmac

# === Cloudflare Turnstile (Story 1.13, @twt/edge) ===
# OPTIONAL — unlike the argon2 pepper, leaving TURNSTILE_SECRET_NAME unset resolves
# the verifier to the no-op default (every request passes), so the stack boots with
# ZERO Cloudflare config. Set the secret NAME to opt into real siteverify.
# TURNSTILE_SECRET_NAME=twt-dev-turnstile-secret
# Local-dev fallback: the Turnstile secret VALUE, read only when Secret Manager is
# unavailable. Cloudflare's documented "always-passes" TEST secret is shown — never
# use a real secret here, and never set the VALUE in any non-local context.
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Override the local-fallback var name (default TURNSTILE_SECRET).
# TURNSTILE_SECRET_ENV_FALLBACK=TURNSTILE_SECRET
# Degraded-mode policy: set to 1 to FAIL OPEN (allow) when siteverify is unreachable.
# Default (unset) is FAIL CLOSED — production rejects when it cannot reach Cloudflare.
# TURNSTILE_FAIL_OPEN=0
# Admin SPA uses a build-time VITE_TURNSTILE_SITE_KEY (public site key) — see apps/admin.

# === Listen port ===
# PORT=3000
