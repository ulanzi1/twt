# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
.next/
.expo/
.astro/
*.tsbuildinfo

# Turbo
.turbo/

# Test output
coverage/

# Vite/Vitest TS-config transpile shims — left behind when a test run is
# killed mid-load; normally self-deleted, harmless build output otherwise
*.timestamp-*.mjs

# Environment
.env
.env.local
.env.*.local

# Misc
.cache/
.tmp/

# BMAD code-review session artifacts (transient diffs the review tooling drops
# at session-time; the substantive patches land in commits, not these files)
_bmad-output/*-review-diff.txt
_bmad-output/**/*-review-diff.txt
.claude/.story-automator-active
.claude/settings.json

# Python bytecode (story-automator skill)
__pycache__/
*.pyc
*.pyo

# Story-automator run artifacts
_bmad-output/story-automator/

# Legal instruments (trust deed, niyamavali, T&C, privacy policy) — DELIBERATELY excluded.
# This repository is PUBLIC. The instruments are UNEXECUTED, agent-drafted and unratified
# ("DRAFT — NOT YET EXECUTED. NOT LEGAL ADVICE"), so publishing them under the Trust's name
# would invite a reader to take a draft for the operative instrument.
#
# ⛔ DO NOT "fix" a missing docs/legal/ by deleting this entry — the absence IS the control.
#
# The corpus IS version-controlled: canonical home is the PRIVATE repo ulanzi1/twt-legal
# (Decision 2026-08-28-167, satisfying 2026-08-21-144 cl.7(a)). See docs/legal-corpus-location.md.
docs/legal/
