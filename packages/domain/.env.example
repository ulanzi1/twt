# packages/domain — local-developer environment variables.
#
# Copy to packages/domain/.env (gitignored) and fill in local values.
# Production paths NEVER read .env — secrets resolve via GCP Secret Manager
# per architecture §5.4 + §5.9.

# Local Postgres connection string (Cloud SQL Auth Proxy on 127.0.0.1:5432,
# or a local Docker Postgres container). Used only when NODE_ENV !== 'production'
# AND GOOGLE_APPLICATION_CREDENTIALS is unset.
# sslmode=disable: correct for Auth Proxy (loopback socket; proxy handles mutual-TLS).
# Direct private-IP without proxy: use sslmode=require instead.
DATABASE_URL=postgresql://twt_dev_app:CHANGE_ME@127.0.0.1:5432/twt_dev?sslmode=disable

# GCP project ID. Required for Secret Manager fetches (ADC paths).
GOOGLE_CLOUD_PROJECT=twt-dev

# Path to a service-account JSON key. Usually LEFT UNSET locally; instead run
# `gcloud auth application-default login` so ADC discovers your user creds.
# Setting this env opts into the Secret Manager fetch path even in dev.
# GOOGLE_APPLICATION_CREDENTIALS=

# Drizzle query-logging toggle. '1' enables; anything else disables.
DRIZZLE_LOG_QUERIES=0

# Force Secret Manager even when local fallback would otherwise apply. Useful
# for verifying the production fetch path end-to-end from a dev workstation.
# DRIZZLE_FORCE_SECRET_MANAGER=0
