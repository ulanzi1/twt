# Hoisted node-linker — flatten node_modules so non-pnpm-aware bundlers
# (Metro / Expo) can find transitive deps via standard Node resolution. Per
# Expo's monorepo guide (https://docs.expo.dev/guides/monorepos/) and the
# canonical pnpm + Expo + Metro compatibility recipe.
node-linker=hoisted

# Auto-install peer dependencies (silences sonner/react-native peer warnings).
auto-install-peers=true
