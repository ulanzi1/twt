#!/usr/bin/env bash
#
# pre-push — run the local CI mirror before every push.
# Active while GitHub Actions is unavailable (account under review).
#
# Enable (one-time, per clone):   git config core.hooksPath .githooks
# Skip once:                      git push --no-verify
#                          (or)   SKIP_CI_LOCAL=1 git push
#
# DOCS-ONLY pushes skip ci:local automatically (BigDev 2026-10-12). A push is docs-only when EVERY file changed by
# the commits it sends is documentation:
#   · any `*.md`, or anything under `_bmad-output/` or `docs/`
#   · EXCEPT the files a ci:local gate READS — `.decision-log.md` (pii-scrape), `friction-budget.md`
#     (friction-budget) and `docs/launch-gate-inventory/` (dlt-typed-variables — the DLT registration sheet). A push
#     touching any of them still runs ci:local.
# Every other gate excludes these paths by design (microcopy, schema-diff, benefit-mechanism: "never the repo root /
# _bmad-output / docs / *.md / sprint-status.yaml"). GitHub CI applies the SAME rule (`.github/workflows/ci.yml`'s `paths`
# filter, 2026-10-12), so a docs-only change runs ⛔ no CI anywhere. ⚠ When a new gate starts reading a doc, add that file to
# GATE_INPUTS below AND to ci.yml's `paths` (re-include it after the docs exclusions).
# ALREADY-PUSHED pushes skip ci:local too (BigDev 2026-10-12): when EVERY commit being sent already exists on a branch of
# the same remote — the fast-forward that lands a PR (`git push origin <tip>:main`, [[feedback-land-prs-by-fast-forward]]) —
# those commits already passed ci:local when their branch was pushed, and GitHub CI on the PR. ⚠ Judged from the LOCAL
# remote-tracking refs: `git fetch` first; a stale ref only makes the hook run ci:local (never skip it wrongly). A branch
# pushed with --no-verify / SKIP_CI_LOCAL=1 is then covered by GitHub CI alone.
# Fail-safe: anything the hook cannot determine (an unknown remote tip, a failed diff, nothing changed) runs ci:local.
#
if [ "${SKIP_CI_LOCAL:-}" = "1" ]; then
  echo "[pre-push] SKIP_CI_LOCAL=1 — skipping ci:local"
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
REMOTE="${1:-origin}"
GATE_INPUTS='^(\.decision-log\.md|friction-budget\.md|docs/launch-gate-inventory/.*)$'
DOCS='(\.md$|^_bmad-output/|^docs/)'

changed=""
undetermined=0
sent=0
all_on_remote=1
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue # a branch deletion sends no commits
  sent=1
  # Any commit of this ref ⛔ not yet on a branch of the remote (or a failed rev-list) ⇒ ⛔ not an already-pushed push.
  unpushed=$(git rev-list "$local_sha" --not --remotes="$REMOTE" 2>/dev/null | head -n 1) || unpushed=unknown
  [ -n "$unpushed" ] && all_on_remote=0
  if [ "$remote_sha" = "$ZERO" ]; then
    # A NEW remote branch: compare against where it leaves main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { undetermined=1; continue; }
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    # The remote tip is unknown locally (e.g. someone else pushed) — can't tell what is new.
    undetermined=1
    continue
  fi
  files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || { undetermined=1; continue; }
  changed="$changed
$files"
done

if [ "$sent" -eq 0 ]; then
  echo "[pre-push] nothing sent (branch deletion only) — skipping ci:local"
  exit 0
fi

if [ "$all_on_remote" -eq 1 ]; then
  echo "[pre-push] every commit sent is already on $REMOTE (a fast-forward of pushed work) — skipping ci:local (it ran when they were pushed)"
  exit 0
fi

changed=$(printf '%s\n' "$changed" | sed '/^$/d' | sort -u)

if [ "$undetermined" -eq 0 ] && [ -n "$changed" ] \
  && ! printf '%s\n' "$changed" | grep -Eq "$GATE_INPUTS" \
  && ! printf '%s\n' "$changed" | grep -Evq "$DOCS"; then
  echo "[pre-push] docs-only push ($(printf '%s\n' "$changed" | wc -l | tr -d ' ') file(s)) — skipping ci:local (GitHub CI skips it too — ci.yml paths)"
  exit 0
fi

echo "[pre-push] running pnpm ci:local (skip with: git push --no-verify) …"
pnpm ci:local
