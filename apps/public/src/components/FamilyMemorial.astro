---
// <FamilyMemorial> — the family's memorial on the public Sahyog Vivran page (Story 11b.4a, MP1 / MP3; `2026-10-23-391` item 2;
// `2026-10-27-411` items 2, 3, 6). Story 11b.5 later lifts this markup into `<MemorialRecord>` / `<PortraitFrame>` (MP1).
//
// ⭐ GATED ON THE MATRIX, the path `<MatrixField>` uses (`visibilityOf` → `getVisibility()`): the section renders only while
// `family_memorial_words` is visible at `public`, and the figure only while `family_memorial_photo` is — ⛔ never markup that
// bypasses the matrix (it would make the three ids decorative). A not-visible verdict renders NOTHING. The three verdicts are
// asked HERE and decided in `lib/family-memorial.ts` (pure, so a test can plant one); a section with nothing in it — the words
// left out whole and the photo hidden — is ⛔ not drawn (no heading over an empty body: Trap 9).
// ⭐ THE WORDS ARE RENDERED AS GIVEN: the API cut the left-out parts, joined the words around them (⛔ no marker — `-411` item 3)
// and isolated their direction controls. One `<p dir="auto">` per paragraph with `white-space: pre-wrap` (HTML collapses the
// spaces and single newlines the family wrote). ⛔ Never `set:html`; Astro `{}` interpolation only. ⛔ No `lang` attribute on
// the family's text — its language is ⛔ not recorded.
// ⭐ THE PHOTO: the UX FuneralFrame as nested wrappers (2 px ink border, 6 pt inner pad, 4:5, `object-fit: contain`), lazy, its
// `alt` the family's description AS APPROVED (⛔ never synthesised; `''` when all of it was left out).
// ⛔ The heading does ⛔ not name the member (their name follows ITS own gate — Trap 14). ⛔ Nothing here reaches `<head>`.
import { planFamilyMemorial } from '../lib/family-memorial.js';
import type { SahyogVivranFamilyMemorialView } from '../lib/surface-fields.js';
import { visibilityOf } from '../lib/matrix.server.js';
import PortraitFrame from './PortraitFrame.astro';

interface Props {
  memorial: SahyogVivranFamilyMemorialView;
  heading: string;
  photoSrc: string;
}

const { memorial, heading, photoSrc } = Astro.props;
const plan = planFamilyMemorial(memorial, {
  words: visibilityOf('sahyog-vivran', 'family_memorial_words', 'public').visible,
  photo: visibilityOf('sahyog-vivran', 'family_memorial_photo', 'public').visible,
  altText: visibilityOf('sahyog-vivran', 'family_memorial_photo_alt_text', 'public').visible,
});
---
{plan.section && (
  <section aria-labelledby="sv-family-memorial-heading" style="margin: var(--space-block) 0 0;" data-field="family_memorial_words">
    <h2 id="sv-family-memorial-heading">{heading}</h2>
    {plan.photo && (
      <figure style="margin: var(--space-row) 0 0;" data-field="family_memorial_photo">
        <PortraitFrame src={photoSrc} alt={plan.alt} />
      </figure>
    )}
    {memorial.familyMemorialWords.map((paragraph) => (
      <p dir="auto" style="white-space: pre-wrap; margin: var(--space-row) 0 0;">{paragraph}</p>
    ))}
  </section>
)}
