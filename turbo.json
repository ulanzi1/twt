{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["PARIWAR_PROFILE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**", ".expo/**", "build/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:check": {
      "dependsOn": [],
      "inputs": [
        "src/schema/**/*.ts",
        "migrations/**/*",
        "drizzle.config.ts",
        "package.json",
        "../../pnpm-lock.yaml"
      ],
      "outputs": []
    },
    "contracts:check-openapi-determinism": {
      "dependsOn": [],
      "inputs": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "package.json",
        "../../pnpm-lock.yaml",
        "../../openapi/v1.yaml"
      ],
      "outputs": []
    },
    "crypto:check": {
      "dependsOn": ["typecheck"],
      "inputs": [
        "src/encryption/**/*.ts",
        "tests/encryption/**/*.ts",
        "package.json",
        "../../pnpm-lock.yaml"
      ],
      "outputs": [],
      "env": ["KMS_TEST_MODE", "DATABASE_URL"]
    }
  }
}
