              </tbody>
            </table>
          </section>
        )}

        {sections.archive.length > 0 && (
          <section aria-labelledby="sahyog-archive-title">
            <h2 id="sahyog-archive-title">{labels.sectionArchiveTitle}</h2>
            <p>{ts('stage.verified.help')}</p>
            <table class="sahyog__table">
              <caption class="sahyog__caption">{labels.tableCaptionArchive}</caption>
              <thead>
