                        ) : (
                          <MatrixField
                            surface="sahyog-drive"
                            field={col.fieldId}
                            viewerContext="public"
                            value={col.valueOf(row) ?? ''}
                          />
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}

        {/* ⚠ Stated on the surface itself, ⛔ not only in a decision record: the family's choice is
            theirs, it is revocable, and revoking removes a NAME rather than a DRIVE. */}
        {view.model.hasDrives && <p class="sahyog__consent-note">{tr('consent.note')}</p>}

        {view.links.length > 0 && (
          <nav class="sahyog__pagination" aria-label={labels.paginationLabel}>
            <ul class="sahyog__pagination-list">
              {view.links.map((link) => (
                <li>
                  <a class="sahyog__link" href={link.href} rel={link.rel}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </>
    )}
  </main>
</PublicShell>

