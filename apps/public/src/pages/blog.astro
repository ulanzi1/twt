---
// The public News/Blog list (Story 10.5, AC7). Fully server-rendered, works with JS disabled. Reads
// only PUBLISHED, `public`-audience posts under an UNAUTHENTICATED `withPublicScope` (twt_app + RLS,
// NOT a superuser bypass — the Story 2.5 pattern `terms.astro`/`niyamavali.astro` already use). No
// authoring metadata (actor ids, channels, workflow) is ever read here — `listPublishedPublicPosts`
// returns only the member-facing fields. Bilingual: the card shows the English title with the Hindi
// title beneath when present.
import { getLocale, isLocale } from '@twt/i18n';
import type { Locale } from '@twt/i18n';
import { newsBlog, passport } from '@twt/domain';
import type { schema } from '@twt/domain';

import PublicShell from '../layouts/PublicShell.astro';
import { getDb, withPublicScope } from '../lib/db.server.js';
import { ACTIVE_PARIWAR_ID } from '../lib/pariwar.server.js';

type PostRow = schema.NewsPostRow;

const langParam = Astro.url.searchParams.get('lang');
const acceptLanguage = Astro.request.headers.get('accept-language') ?? undefined;
const db = getDb().db;
const passportRow = await passport.getPariwarPassportCached(db, ACTIVE_PARIWAR_ID);
const locale: Locale = isLocale(langParam)
  ? langParam
  : getLocale({ pariwarPassportLocale: passportRow?.localeDefault, acceptLanguage });
const trustName =
  (locale === 'hi'
    ? (passportRow?.displayNameHi ?? passportRow?.displayNameEn)
    : (passportRow?.displayNameEn ?? passportRow?.displayNameHi)) ?? 'News';
const branding = passportRow?.brandingBundle ?? null;

const posts: PostRow[] = await withPublicScope((scoped) =>
  newsBlog.listPublishedPublicPosts(scoped, ACTIVE_PARIWAR_ID, { limit: 50 }),
);

function fmtDate(d: Date | null): string {
  return d ? d.toISOString().slice(0, 10) : '';
}
---

<PublicShell title={`News — ${trustName}`} trustName={trustName} branding={branding} locale={locale}>
  <main class="mx-auto max-w-2xl px-4 py-8">
    <h1 class="mb-6 text-2xl font-semibold">News</h1>
    {posts.length === 0 && <p class="text-gray-500">No announcements yet.</p>}
    <ul class="space-y-4">
      {posts.map((p) => (
        <li class="rounded border p-4">
          <a href={`/blog/${p.postId}`} class="block hover:underline">
            <h2 class="text-lg font-medium">{p.title}</h2>
            {p.titleHi && <p class="text-gray-700">{p.titleHi}</p>}
          </a>
          <p class="mt-1 text-xs text-gray-500">{fmtDate(p.publishedAt)}</p>
        </li>
      ))}
    </ul>
  </main>
</PublicShell>
