#!/usr/bin/env bash
#
# pre-push — run the local CI mirror before every push.
# Active while GitHub Actions is unavailable (account under review).
#
# Enable (one-time, per clone):   git config core.hooksPath .githooks
# Skip once:                      git push --no-verify
#                          (or)   SKIP_CI_LOCAL=1 git push
#
# DOCS-ONLY pushes skip ci:local automatically (BigDev 2026-10-12). A push is docs-only when EVERY file changed by
# the commits it sends is documentation:
#   · any `*.md`, or anything under `_bmad-output/` or `docs/`
#   · EXCEPT the two files a ci:local gate READS — `.decision-log.md` (pii-scrape) and `friction-budget.md`
#     (friction-budget). A push touching either still runs ci:local.
# Every other gate excludes these paths by design (microcopy, schema-diff, benefit-mechanism: "never the repo root /
# _bmad-output / docs / *.md / sprint-status.yaml"). GitHub CI still runs the FULL suite on the PR, so the skip only
# saves the local run. ⚠ When a new gate starts reading a doc, add that file to GATE_INPUTS below.
# Fail-safe: anything the hook cannot determine (an unknown remote tip, a failed diff, nothing changed) runs ci:local.
#
if [ "${SKIP_CI_LOCAL:-}" = "1" ]; then
  echo "[pre-push] SKIP_CI_LOCAL=1 — skipping ci:local"
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
GATE_INPUTS='^(\.decision-log\.md|friction-budget\.md)$'
DOCS='(\.md$|^_bmad-output/|^docs/)'

changed=""
undetermined=0
sent=0
# git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue # a branch deletion sends no commits
  sent=1
  if [ "$remote_sha" = "$ZERO" ]; then
    # A NEW remote branch: compare against where it leaves main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || { undetermined=1; continue; }
  elif git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    # The remote tip is unknown locally (e.g. someone else pushed) — can't tell what is new.
    undetermined=1
    continue
  fi
  files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null) || { undetermined=1; continue; }
  changed="$changed
$files"
done

if [ "$sent" -eq 0 ]; then
  echo "[pre-push] nothing sent (branch deletion only) — skipping ci:local"
  exit 0
fi

changed=$(printf '%s\n' "$changed" | sed '/^$/d' | sort -u)

if [ "$undetermined" -eq 0 ] && [ -n "$changed" ] \
  && ! printf '%s\n' "$changed" | grep -Eq "$GATE_INPUTS" \
  && ! printf '%s\n' "$changed" | grep -Evq "$DOCS"; then
  echo "[pre-push] docs-only push ($(printf '%s\n' "$changed" | wc -l | tr -d ' ') file(s)) — skipping ci:local (GitHub CI still runs on the PR)"
  exit 0
fi

echo "[pre-push] running pnpm ci:local (skip with: git push --no-verify) …"
pnpm ci:local
