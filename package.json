{
  "name": "twt",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "db:generate": "pnpm --filter @twt/domain db:generate",
    "db:migrate": "pnpm --filter @twt/domain db:migrate",
    "db:check": "turbo run db:check",
    "db:studio": "pnpm --filter @twt/domain db:studio",
    "contracts:emit-openapi": "pnpm --filter @twt/contracts contracts:emit-openapi",
    "contracts:check-openapi-determinism": "turbo run contracts:check-openapi-determinism",
    "tokens:check-theme": "turbo run tokens:check-theme-determinism",
    "tokens:generate-theme": "pnpm --filter @twt/tokens tokens:generate-theme",
    "i18n:check": "turbo run i18n:check-parity",
    "pii:check": "turbo run contracts:check-pii-scrape",
    "crypto:check": "turbo run crypto:check",
    "friction:check": "tsx scripts/friction-budget/check.ts",
    "friction:test": "vitest run scripts/friction-budget",
    "schema:check": "tsx scripts/schema-diff/check.ts",
    "schema:test": "vitest run scripts/schema-diff",
    "benefit:check": "tsx scripts/benefit-mechanism/check.ts",
    "benefit:test": "vitest run scripts/benefit-mechanism",
    "microcopy:check": "tsx scripts/microcopy/check.ts",
    "microcopy:test": "vitest run scripts/microcopy",
    "cadence:check": "tsx scripts/cadence-check/check.ts",
    "ci:local": "bash scripts/ci-local.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "4.19.0",
    "turbo": "^2.9.16",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.50.0",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
