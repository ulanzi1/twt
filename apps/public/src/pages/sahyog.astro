<PublicShell
  locale={locale}
  title={labels.pageTitle}
  description={labels.pageIntro}
  trustName={trustName}
  branding={branding}
  noindex
>
  <main class="sahyog" aria-labelledby="sahyog-title">
    <h1 id="sahyog-title" class="sahyog__title">{labels.pageTitle}</h1>

    {effectiveRejection !== null && (
      <section class="sahyog__notice" role="alert" aria-labelledby="sahyog-rejected-title">
        <h2 id="sahyog-rejected-title" class="sahyog__notice-title">{effectiveRejection.title}</h2>
        <p class="sahyog__notice-body">{effectiveRejection.body}</p>
        <p><a class="sahyog__link" href={effectiveRejection.linkHref}>{effectiveRejection.linkLabel}</a></p>
      </section>
    )}

    {view !== null && (
      <>
        <p class="sahyog__intro">{labels.pageIntro}</p>

        {/* ⭐⭐ THE STAGE EXPLAINER — `2026-09-04-192` cl.3's INFO AFFORDANCE (Story 11b.12 AC3).
            ⛔⛔ IT IS A NATIVE `<details>`, ⛔ NOT A TOOLTIP, AND THAT IS LOAD-BEARING:
            · this page is server-rendered and carries ⛔ ZERO `<script>` — a JS tooltip could not
              work here at all;
            · HOVER IS ⛔ NOT AN AFFORDANCE (family 13 check (c)) — it is unreachable by keyboard
              AND by touch, and most members are on phones. `<summary>` is natively focusable,
              natively clickable/tappable, and carries its own accessible name.
            ⭐⭐ THIS IS THE FIRST `<details>` IN `apps/public` — there was ⛔ no house pattern to
            inherit, so this ESTABLISHES one: the marker reset + an explicit `:focus-visible` ring
            live at `.sahyog__explainer` in this file's `<style>`. ⛔ Without both, it ships a
            browser-default triangle and an INVISIBLE focus state onto a designed page.
            ⚠ **Verified** is explained even though ⛔ NO drive can currently be in that stage —
            `pool.settled` still has ⛔ no production producer. A stage a visitor may never see is
            still one the vocabulary promises to define. */}
        <details class="sahyog__explainer">
          <summary aria-label={ts('stage.explainer.a11y')}>
            <span aria-hidden="true" class="sahyog__explainer-icon">i</span>
            <span>{ts('stage.explainer.summary')}</span>
          </summary>
          <dl class="sahyog__explainer-body">
            <dt>{ts('stage.live')}</dt>
            <dd>{ts('stage.live.help')}</dd>
            <dt>{ts('stage.closed')}</dt>
            <dd>{ts('stage.closed.help')}</dd>
            <dt>{ts('stage.verified')}</dt>
            <dd>{ts('stage.verified.help')}</dd>
          </dl>
        </details>

        {/* ⭐ The three ruled filters, as PLAIN GET parameters on a REAL form — the shell's
            works-with-JS-disabled posture (Story 2.5 AC3). ⛔ No JS, no fetch, no island.
            ⛔ There is NO name field, and the note says so rather than leaving its absence to be
            read as an oversight. */}
        <form class="sahyog__filters" method="get" action="/sahyog">
          {/* ⭐⛔ THE LOCALE RIDES THE FORM, OR THE SEARCH DROPS IT (Review finding, 2026-08-27).
              A GET submit REPLACES the entire query string, so a Hindi reader who arrived at
              `/sahyog?lang=hi`, typed a district and pressed खोजें landed on `/sahyog?district=…`
              with `lang` GONE — falling back to `Accept-Language`, which for a browser configured
              in English silently flips the whole page to English mid-task. ⛔ On a page addressed
              to grieving families that is not cosmetic.
              ⚠ Emitted ONLY when the visitor actually chose a locale: an unconditional hidden
              field would pin the negotiated default into the URL and mint a second cache key for
              what is byte-identical output. */}
          {langParam !== null && isLocale(langParam) && (
            <input type="hidden" name="lang" value={langParam} />
          )}
          <fieldset>
            <legend>{tr('filter.legend')}</legend>
            <p class="sahyog__filter-row">
              <label for="f-district">{tr('filter.district.label')}</label>
              {/* ⚠ `maxlength` MIRRORS the API's `z.string().trim().max(120)` / `.max(64)`. It is
                  a courtesy that keeps an ordinary typo from becoming a round-trip refusal — ⛔ NOT
                  the enforcement, which stays server-side where it cannot be edited away. */}
              <input
                id="f-district"
