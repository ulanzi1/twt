              </thead>
              <tbody>
                {sections.archive.map((row) => (
                  <tr>
                    {driveColumns.map((col) => (
                      <td>
                        {/* ⭐ Story 11b.10 (AC3) — the DRIVE LINK arm. ⚠ A REAL `<a href>`, ⛔ never
                            a JS-dependent button: this page is server-rendered and its links must
                            work with no client script, exactly like the pagination controls.
                            ⛔ `aria-label` names WHICH drive it opens — ⛔ never a bare "click here"
                            (family 13). ⛔ The value still goes through `<MatrixField>`, so
                            `getVisibility()` remains the ONLY thing deciding what appears. */}
                        {col.hrefOf !== undefined ? (
                          <a href={col.hrefOf(row)} aria-label={col.a11yOf?.(row)}>
                            <MatrixField
                              surface="sahyog-drive"
                              field={col.fieldId}
                              viewerContext="public"
                              value={col.valueOf(row) ?? ''}
                            />
